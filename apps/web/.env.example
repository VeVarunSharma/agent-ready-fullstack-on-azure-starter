# Required runtime mode: local, test, or production.
RUNTIME_MODE=

# Required database mode: disabled, local-password, azure-managed-identity, or local-azure-credential.
DATABASE_MODE=

# Required authentication mode: disabled or container-apps.
AUTH_MODE=

# Required logging mode: json or silent.
LOGGING_MODE=

# Required telemetry mode: disabled or reserved azure-monitor. Azure Monitor fails closed until its
# dependency graph and Next.js startup hook comply with repository policy.
TELEMETRY_MODE=

# Browser-safe runtime label. It must not contain secrets.
NEXT_PUBLIC_RUNTIME_MODE=

# Required only when database use is enabled.
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=

# Local development only. Production password authentication is rejected.
DATABASE_PASSWORD=

# Optional bounded pool and readiness-probe settings.
DATABASE_POOL_MAX=
DATABASE_PROBE_TIMEOUT_MS=

# Required only for Azure managed identity database mode.
AZURE_CLIENT_ID=

# Prohibited while telemetry is disabled. Reserved for a future compliant Azure Monitor exporter.
APPLICATIONINSIGHTS_CONNECTION_STRING=
