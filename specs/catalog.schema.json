{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRD catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "entries"],
  "properties": {
    "$schema": {
      "const": "../catalog.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "path",
        "title",
        "summary",
        "lifecycle",
        "owners",
        "created",
        "updated",
        "dataClassification",
        "supersededBy",
        "architectureImpact",
        "designSystemImpact",
        "sensitiveDataImpact",
        "persistenceImpact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(?:\\.[0-9]+)?$"
        },
        "path": {
          "type": "string",
          "pattern": "^specs/PRDs/PRD_V[1-9][0-9]*(?:\\.[0-9]+)?_[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*\\.md$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "enum": ["active", "current", "historical", "superseded"]
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "created": {
          "type": "string",
          "format": "date"
        },
        "updated": {
          "type": "string",
          "format": "date"
        },
        "dataClassification": {
          "enum": ["Public", "Internal", "Confidential", "Restricted"]
        },
        "supersededBy": {
          "type": ["string", "null"]
        },
        "architectureImpact": {
          "type": "boolean"
        },
        "designSystemImpact": {
          "type": "boolean"
        },
        "sensitiveDataImpact": {
          "type": "boolean"
        },
        "persistenceImpact": {
          "type": "boolean"
        }
      }
    }
  }
}
